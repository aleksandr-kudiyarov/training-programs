@using Kudiyarov.TrainingPrograms.Web.Models
@model Kudiyarov.TrainingPrograms.Programs.TrainingProgram

@{
    ViewBag.Title = Model.Name;
    Layout = "_Layout";

    var breadcrumb = new BreadcrumbViewModel
    {
        Items =
        [
            new BreadcrumbItem
            {
                Text = "Programs",
                Controller = "Home",
                Action = "Index"
            },

            new BreadcrumbItem
            {
                Text = Model.Name,
                IsActive = true
            }
        ]
    };
}

@await Html.PartialAsync("_Breadcrumb", breadcrumb)

<h1 class="mb-4">@Model.Name</h1>

<ol class="list-group list-group-numbered">
    @for (var day = 1; day <= Model.Days; day++)
    {
        var request = new ApiSessionRequest
        {
            ProgramType = Model.Type,
            Day = day
        };

        <li class="list-group-item">
            @Html.ActionLink($"Session {day}", "Session", request, new { @class = "text-decoration-none", aria_label = $"View session {day} of {Model.Name} program" })
        </li>
    }
</ol>
