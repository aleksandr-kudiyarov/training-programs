@using Kudiyarov.TrainingPrograms.Web.Models
@model Kudiyarov.TrainingPrograms.Programs.TrainingProgram

@{
    ViewBag.Title = "title";
}

<h3>@Model.Name</h3>

<ol>
    @for (var day = 1; day <= Model.Days; day++)
    {
        var request = new ApiSessionRequest
        {
            ProgramType = Model.Type,
            Day = day
        };

        <li>@Html.ActionLink($"Session {day}", "Session", request)</li>
    }    
</ol>
