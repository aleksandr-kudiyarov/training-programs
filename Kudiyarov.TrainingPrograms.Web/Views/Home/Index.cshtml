@using Kudiyarov.TrainingPrograms.Web.Models
@model IEnumerable<Kudiyarov.TrainingPrograms.Programs.TrainingProgram>

@{
    ViewBag.Title = "Training Programs";
    Layout = "_Layout";
    
    var breadcrumb = new BreadcrumbViewModel
    {
        Items =
        [
            new BreadcrumbItem
            {
                Text = "Programs",
                Controller = "Home",
                Action = "Index",
                IsActive = true
            }
        ]
    };
}

@await Html.PartialAsync("_Breadcrumb", breadcrumb)

<div class="card">
    <div class="card-body">
        <ul class="list-group list-group-flush">
            @foreach (var program in Model)
            {
                <li class="list-group-item">
                    @Html.ActionLink(program.Name, "Program", new { programName = program.Name }, new { @class = "text-decoration-none", aria_label = $"View {program.Name} training program details" })
                </li>
            }
        </ul>
    </div>
</div>
