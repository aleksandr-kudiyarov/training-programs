@using Kudiyarov.TrainingPrograms.Web.Models
@model IEnumerable<Kudiyarov.TrainingPrograms.Programs.TrainingProgram>

@{
    ViewBag.Title = "Training Programs";
    Layout = "_Layout";
    
    var breadcrumb = new BreadcrumbViewModel
    {
        Items =
        [
            new BreadcrumbItem
            {
                Text = "Programs",
                Controller = "Home",
                Action = "Index",
                IsActive = true
            }
        ]
    };
}

@await Html.PartialAsync("_Breadcrumb", breadcrumb)

<ul class="list-group">
    @foreach (var program in Model)
    {
        <li class="list-group-item">
            @Html.ActionLink(program.Name, "Program", new { type = (int)program.Type }, new { @class = "text-decoration-none", aria_label = $"View {program.Name} training program details" })
        </li>
    }
</ul>
