@using Kudiyarov.TrainingPrograms.Web.Formatting
@using Kudiyarov.TrainingPrograms.Web.Models
@model Kudiyarov.TrainingPrograms.Web.Models.SessionViewModel

@{
    ViewData["Title"] = $"Session {Model.Session.Day}";
    Layout = "_Layout";
    var timer = TimeSpan.Zero;
    var sessionMarkdown = SessionMarkdownFormatter.Format(Model.Session);

    var breadcrumb = new BreadcrumbViewModel
    {
        Items =
        [
            new BreadcrumbItem
            {
                Text = "Programs",
                Controller = "Home",
                Action = "Index"
            },
            new BreadcrumbItem
            {
                Text = Model.Program.Name,
                Controller = "Home",
                Action = "Program",
                RouteValues = new { programName = Model.Program.Name }
            },
            new BreadcrumbItem
            {
                Text = $"Session {Model.Session.Day}",
                IsActive = true
            }
        ]
    };
}

@await Html.PartialAsync("_Breadcrumb", breadcrumb)

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h4 mb-0">Session @Model.Session.Day</h2>
    <button id="copy-session-markdown" class="btn btn-outline-primary" type="button">
        Copy Markdown
    </button>
</div>
<textarea id="session-markdown" hidden readonly>@sessionMarkdown</textarea>
<div id="copy-session-feedback" class="visually-hidden" role="status" aria-live="polite"></div>

@foreach (var round in Model.Session.Rounds)
{
    for (var r = 0; r < round.Rounds; r++)
    {
        foreach (var exercise in round.Exercises)
        {
            <div class="card mb-3">
                <div class="card-header">
                    @exercise.Name
                </div>
                <div class="card-body">
                    <ol class="list-group list-group-flush">
                        @foreach (var repeat in exercise.Repeats)
                        {
                            var repeatDescription = SessionMarkdownFormatter.FormatRepeat(exercise, repeat);
                            for (var s = 0; s < repeat.Sets; s++)
                            {
                                var formattedTimer = timer.ToString(@"hh\:mm\:ss");
                                <li class="list-group-item">
                                    <span class="badge bg-dark me-2">@formattedTimer</span>
                                    @repeatDescription
                                </li>
                                timer += TimeSpan.FromMinutes(2, 30);
                            }
                        }
                    </ol>
                </div>
            </div>
        }
    }
}

@await Html.PartialAsync("_Pagination", Model)

@section Scripts {
    <script>
        (() => {
            const button = document.getElementById('copy-session-markdown');
            const markdown = document.getElementById('session-markdown');
            const feedback = document.getElementById('copy-session-feedback');
            const originalLabel = button.textContent.trim();

            button.addEventListener('click', async () => {
                try {
                    if (!navigator.clipboard?.writeText) {
                        throw new Error('Clipboard API unavailable');
                    }
                    await navigator.clipboard.writeText(markdown.value);
                    button.textContent = 'Copied!';
                    feedback.textContent = 'Training session copied as Markdown.';
                } catch {
                    button.textContent = originalLabel;
                    feedback.textContent = 'Could not copy. Select and copy the Markdown below.';
                    markdown.hidden = false;
                    markdown.classList.add('form-control', 'mt-2', 'mb-3');
                    markdown.rows = 10;
                    markdown.focus();
                    markdown.select();
                    markdown.scrollIntoView({ block: 'nearest' });
                    return;
                }
                button.addEventListener('blur', () => {
                    button.textContent = originalLabel;
                }, { once: true });
            });
        })();
    </script>
}
